# Copy to .env, fill in what you have, and load it before starting `resumes web`:
#
#     set -a; . ./.env; set +a
#     uv run resumes web --open
#
# .env is ignored by git. Nothing here is needed to install, build, browse or filter.

# The chat, the ranking, free-text search (--text) and job-description matching (--like); also needed to add your
# own resumes (embeddings, and the LLM step unless `--extractor none`). https://platform.openai.com/api-keys
OPENAI_API_KEY=

# The chat and the ranking on OpenRouter's free models (the app offers only those on OpenRouter).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: sign-up by email and SMS code (`resumes web --signup`). Without these, sign-up stays off;
# RESUMES_SIGNUP_DRYRUN=1 tries it with nothing sent (the codes are printed in the terminal).
# RESEND_API_KEY=
# RESEND_FROM="Semantic search <noreply@your-domain.example>"
# SAKARI_ACCOUNT_ID=
# SAKARI_CLIENT_ID=
# SAKARI_CLIENT_SECRET=
