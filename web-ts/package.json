{
  "name": "semantic-search-demo-web",
  "private": true,
  "type": "module",
  "description": "The app server of `resumes web`: the page, the assistant on pi (pi-agent-core + pi-ai in-process), the ranking calls, settings and providers. The Python engine sits behind its HTTP API (`resumes engine`).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.74.0",
    "@earendil-works/pi-ai": "0.74.0",
    "@earendil-works/pi-coding-agent": "0.74.0",
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.11",
    "libphonenumber-js": "^1.13.14"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0"
  }
}
